<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="450.0" minWidth="420.0" prefHeight="600.0" prefWidth="420.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="genie.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.bottomAnchor="68.0" AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" fillWidth="true" spacing="10.0">
                    <padding>
                        <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT" maxHeight="68.0" minHeight="68.0" prefHeight="68.0"
              styleClass="input-bar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="48.0"
                       promptText="Enter a command..." HBox.hgrow="ALWAYS" />
            <Button onAction="#handleUserInput" mnemonicParsing="false"
                    prefHeight="48.0" prefWidth="92.0" text="Send" />
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="8.0" />
            </padding>
        </HBox>
    </children>
</AnchorPane>
